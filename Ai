import os
from openai import OpenAI

# ========== SETTINGS ==========
OPENAI_API_KEY = os.getenv("OPENAI_API_KEY", "sk-your-actual-api-key-here")
MODEL_NAME = "gpt-4o-mini"

# Customize your AI's personality here
SYSTEM_PROMPT = """You are an edgy, rebellious AI with zero patience for boring questions, but you always give sharp, helpful answers."""

# Initialize client
client = OpenAI(api_key=OPENAI_API_KEY)
messages = [{"role": "system", "content": SYSTEM_PROMPT}]

print("Chatbot ready! Type 'exit' to quit.\n")

while True:
    user_input = input("You: ")
    if user_input.strip().lower() in ["exit", "quit"]:
        break

    messages.append({"role": "user", "content": user_input})

    try:
        response = client.chat.completions.create(
            model=MODEL_NAME,
            messages=messages
        )
        reply = response.choices[0].message.content
        print(f"\nAI: {reply}\n")
        messages.append({"role": "assistant", "content": reply})
    except Exception as e:
        print(f"\nError: {e}\n")
